{% extends 'base.html.twig' %}

{% block title %}WMFFL Activations{% endblock %}

{% block content %}
<h1 class="full">Activations</h1>

{{ include('activations/_nav.html.twig') }}

{% for message in app.flashes('success') %}
<div class="alert alert-success" role="alert">{{ message }}</div>
{% endfor %}

<form method="get" action="{{ path('activations') }}" class="form-inline justify-content-center mb-3">
    <input type="hidden" name="season" value="{{ season }}">
    <label class="mr-2" for="week">Week</label>
    <select class="form-control mr-2" id="week" name="week">
        {% for option in weeks %}
        <option value="{{ option.week }}"{% if option.week == week %} selected{% endif %}>{{ option.weekname }}</option>
        {% endfor %}
    </select>
    <button type="submit" class="btn btn-wmffl">Go</button>
</form>

{% if matchups is empty %}
<p class="text-center text-muted">No games are scheduled for week {{ week }} of {{ season }}.</p>
{% endif %}

{# One block per scheduled game: the two lineups side by side on a wide
   screen, stacked on a phone. #}
{% for matchup in matchups %}
<div class="row mb-3">
    {% for team in matchup.teams %}
    <div class="col-12 col-md-6 mb-3 mb-md-0">
        <div class="card h-100">
            <div class="card-header font-weight-bold">{{ team.name }}</div>
            <div class="card-body px-2 py-1">
                {% if team.players is empty %}
                <div class="text-muted py-2">No activations submitted.</div>
                {% endif %}
                {% for player in team.players %}
                <div class="row my-1">
                    <div class="col-3 col-sm-2 pr-0">{% if player.locked %}*{% endif %}{{ player.pos }}</div>
                    <div class="col-9 col-sm-4 text-left pl-0 pl-sm-3">{{ player.name }}</div>
                    <div class="col-9 col-sm-4 offset-3 offset-sm-0">{{ player.opp }}</div>
                    <div class="col-12 col-sm-2 pl-0 pl-sm-3">
                        {% if player.injuryLabel %}
                        <span class="PQDO" title="{{ player.injuryDetail }}">({{ player.injuryLabel }})</span>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
    {% endfor %}
</div>
{% endfor %}

<p class="text-muted small">
    * marks a player whose activation is locked - his NFL game is within
    five minutes of kickoff.
</p>
{% endblock %}
