{% extends 'admin/base.html.twig' %}

{% block title %}Admin - {{ teamName }} lineup, {{ season }} week {{ week }}{% endblock %}

{% block stylesheets %}
    {# ?v bumped whenever these change - Apache caches them hard,
   same convention as core.css?v12 in base.html.twig #}
    <link rel="stylesheet" type="text/css" href="/css/activations.css?v2">
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <script src="/js/activations.js?v2" defer></script>
{% endblock %}

{% block admin_content %}
<h2 class="mt-2">{{ teamName }} &mdash; {{ season }}, week {{ week }}</h2>

<p class="text-muted">
    Every player is editable here regardless of kickoff or the week 14
    acquisition rule. The list is the team's <em>current</em> roster.
</p>

{% if errors is not empty %}
<div class="alert alert-danger">
    <ul class="mb-0">
        {% for error in errors %}<li>{{ error }}</li>{% endfor %}
    </ul>
</div>
{% endif %}

{# Jump straight to another team or week without going back to the list #}
<div class="form-inline mb-3">
    <label class="mr-2" for="jumpTeam">Team</label>
    <select class="form-control mr-3" id="jumpTeam"
            onchange="window.location = this.value">
        {% for option in teams %}
        <option value="{{ path('admin_activations_edit', {teamId: option.teamid, season: season, week: week}) }}"
                {% if option.teamid == teamId %}selected{% endif %}>{{ option.name }}</option>
        {% endfor %}
    </select>
    <label class="mr-2" for="jumpWeek">Week</label>
    <select class="form-control mr-3" id="jumpWeek"
            onchange="window.location = this.value">
        {% for option in weeks %}
        <option value="{{ path('admin_activations_edit', {teamId: teamId, season: season, week: option.week}) }}"
                {% if option.week == week %}selected{% endif %}>{{ option.weekname }}</option>
        {% endfor %}
    </select>
    <a class="btn btn-wmffl" href="{{ path('admin_activations', {season: season}) }}">Back to all teams</a>
</div>

<form method="post" action="{{ path('admin_activations_save', {teamId: teamId, season: season, week: week}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('admin_activations') }}"/>

    {{ include('activations/_lineup_form.html.twig') }}

    <div class="form-check my-3">
        <input type="checkbox" class="form-check-input" id="allowIllegal" name="allowIllegal" value="1">
        <label class="form-check-label" for="allowIllegal">
            Save anyway (illegal lineup) - keep the lineup exactly as
            submitted even if it breaks the position limits
        </label>
    </div>

    <div class="text-center my-3">
        <button type="submit" class="btn btn-wmffl" id="lineup-submit">Save Lineup</button>
    </div>
</form>
{% endblock %}
