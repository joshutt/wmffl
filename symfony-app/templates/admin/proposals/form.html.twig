{% extends 'admin/base.html.twig' %}

{% block title %}Admin - {{ issue ? 'Edit' : 'New' }} Proposal{% endblock %}

{% block admin_content %}
<h2 class="mt-2">{{ issue ? 'Edit' : 'New' }} Proposal</h2>

<form method="post"
      action="{{ issue ? path('admin_proposals_update', {id: issue.id}) : path('admin_proposals_create') }}">
    <input type="hidden" name="_token" value="{{ csrf_token('admin_proposals') }}"/>

    <div class="row">
        <div class="col-md-3 mb-3">
            <label class="form-label">Proposal # (IssueNum)</label>
            <input type="text" name="issueNum" class="form-control" maxlength="10"
                   value="{{ issue ? issue.issueNum : '' }}">
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Name</label>
            <input type="text" name="issueName" class="form-control" maxlength="120" required
                   value="{{ issue ? issue.issueName : '' }}">
        </div>
        <div class="col-md-3 mb-3">
            <label class="form-label">Season</label>
            <input type="number" name="season" class="form-control" required
                   value="{{ issue ? issue.season : currentSeason }}">
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 mb-3">
            <label class="form-label">Status</label>
            <select name="status" class="form-control">
                {% for s in ['Open', 'Passed', 'Rejected', 'Withdrawn'] %}
                    <option value="{{ s }}" {% if issue and issue.status.value == s %}selected{% endif %}>{{ s }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-3 mb-3">
            <label class="form-label">Start Date</label>
            <input type="date" name="startDate" class="form-control"
                   value="{{ issue and issue.startDate ? issue.startDate|date('Y-m-d') : '' }}">
        </div>
        <div class="col-md-3 mb-3">
            <label class="form-label">Deadline</label>
            <input type="date" name="deadline" class="form-control"
                   value="{{ issue and issue.deadline ? issue.deadline|date('Y-m-d') : '' }}">
        </div>
        <div class="col-md-3 mb-3 d-flex align-items-end">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="published" value="1"
                       id="published" {% if issue and issue.published %}checked{% endif %}>
                <label class="form-check-label" for="published">Published (visible to members)</label>
            </div>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Short Description</label>
        <textarea name="description" class="form-control" rows="2">{{ issue ? issue.description : '' }}</textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Rationale (Markdown)</label>
        <textarea name="rationale" class="form-control" rows="4">{{ issue ? issue.rationale : '' }}</textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Proposed Rule Change (Markdown)</label>
        <textarea name="ruleChange" class="form-control" rows="4">{{ issue ? issue.ruleChangeText : '' }}</textarea>
    </div>

    <fieldset class="border rounded p-3 mb-3">
        <legend class="h6">Co-sponsors (in order)</legend>
        <p class="text-muted small mb-2">Choose sponsors top to bottom; the first is the primary sponsor.
            Leave a row blank to skip it.</p>
        {% set existing = issue ? issue.sponsors|map(s => s.user ? s.user.id : 0) : [] %}
        {% set slotCount = max(existing|length + 2, 4) %}
        {% for i in 0..(slotCount - 1) %}
        <div class="mb-2">
            <select name="sponsors[]" class="form-control">
                <option value="">— none —</option>
                {% for user in users %}
                    <option value="{{ user.id }}"
                        {% if existing[i] is defined and existing[i] == user.id %}selected{% endif %}>
                        {{ user.name }}
                    </option>
                {% endfor %}
            </select>
        </div>
        {% endfor %}
    </fieldset>

    <div class="text-center">
        <button type="submit" class="btn btn-wmffl">Save</button>
        <a href="{{ path('admin_proposals') }}" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

{% if issue %}
<hr class="my-4">
<div class="d-flex">
    <form method="post" action="{{ path('admin_proposals_withdraw', {id: issue.id}) }}"
          class="mr-2"
          onsubmit="return confirm('Withdraw this proposal?');">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_proposals') }}"/>
        <button type="submit" class="btn btn-outline-warning">Withdraw</button>
    </form>
    <form method="post" action="{{ path('admin_proposals_delete', {id: issue.id}) }}"
          onsubmit="return confirm('Permanently delete this proposal and its ballot rows?');">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_proposals') }}"/>
        <button type="submit" class="btn btn-outline-danger">Delete</button>
    </form>
</div>
{% endif %}
{% endblock %}
