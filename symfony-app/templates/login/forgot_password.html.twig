{% extends 'base.html.twig' %}

{% block title %}Forgot Password{% endblock %}

{% block content %}
<h1 class="full">Forgot Your WMFFL Password?</h1>

<div class="row justify-content-center m-2">
    <div class="col-md-6 col-lg-4">
        {% if sent %}
            <div class="alert alert-success" role="alert">
                If that account exists, a link to set a new password has been
                emailed to its addresses. The link works once and expires in an hour.
            </div>
        {% endif %}

        <p>Enter your username and we'll email you a link to choose a new password.</p>

        <form method="post" action="{{ path('password_forgot') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('password_forgot') }}">
            <div class="form-group">
                <label for="forgotUsername">Username</label>
                <input type="text" class="form-control" id="forgotUsername" name="username" maxlength="20" required autofocus>
            </div>
            <div class="text-center">
                <button type="submit" class="btn btn-wmffl">Email Me a Link</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
