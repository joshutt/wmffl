{% extends 'base.html.twig' %}

{% block title %}Set Password{% endblock %}

{% block content %}
<h1 class="full">Set Your WMFFL Password</h1>

<div class="row justify-content-center m-2">
    <div class="col-md-6 col-lg-4">
        {% if done %}
            <div class="alert alert-success" role="alert">Your password has been set.</div>
            <div class="text-center">
                <button type="button" class="btn btn-wmffl" data-toggle="modal" data-target="#loginModal">Log In</button>
            </div>
        {% elseif not valid %}
            <div class="alert alert-danger" role="alert">
                This link is invalid, has already been used, or has expired.
            </div>
            <div class="text-center">
                <a class="btn btn-wmffl" href="{{ path('password_forgot') }}">Request a New Link</a>
            </div>
        {% else %}
            {% if error %}
                <div class="alert alert-danger" role="alert">{{ error }}</div>
            {% endif %}

            <p>Choose a new password for <strong>{{ username }}</strong>. It must be at least {{ minLength }} characters long.</p>

            <form method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('password_reset') }}">
                <input type="text" name="username" value="{{ username }}" autocomplete="username" hidden>
                <div class="form-group">
                    <label for="newPassword">New password</label>
                    <input type="password" class="form-control" id="newPassword" name="newPassword" minlength="{{ minLength }}" autocomplete="new-password" required autofocus>
                </div>
                <div class="form-group">
                    <label for="confirmPassword">New password again</label>
                    <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" minlength="{{ minLength }}" autocomplete="new-password" required>
                </div>
                <div class="text-center">
                    <button type="submit" class="btn btn-wmffl">Set Password</button>
                </div>
            </form>
        {% endif %}
    </div>
</div>
{% endblock %}
