{% extends 'base.html.twig' %}

{% block title %}Rule Proposals - WMFFL{% endblock %}

{% block content %}
<div class="cat text-center">RULE PROPOSALS</div>
<div class="container pb-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap my-3">
        <form method="get" class="d-flex align-items-center">
            <label for="season" class="mb-0 mr-2"><b>Season:</b></label>
            <select name="season" id="season" class="form-control w-auto d-inline-block" onchange="this.form.submit()">
                {% for s in seasons %}
                    <option value="{{ s }}" {% if s == season %}selected{% endif %}>{{ s }}</option>
                {% endfor %}
                {% if season not in seasons %}
                    <option value="{{ season }}" selected>{{ season }}</option>
                {% endif %}
            </select>
        </form>
        {% if auth.isLoggedIn %}
        <div class="text-center">
            <a href="{{ path('ballot') }}" class="btn btn-wmffl">Ballot</a>
        </div>
        {% endif %}
    </div>

    {% if proposals is empty %}
        <p class="text-muted">No proposals have been published for {{ season }}.</p>
    {% else %}
        {% for issue in proposals %}
        <div class="card m-3 p-2 bg-light">
            <div class="card-header">
                <b>Proposal {{ issue.issueNum ?: issue.season }} - {{ issue.issueName }}</b>
            </div>
            <div class="card-body">
                {% if issue.sponsors|length > 0 %}
                <p class="mb-1"><b>Sponsor{{ issue.sponsors|length > 1 ? 's' : '' }}:</b>
                    {% for sponsor in issue.sponsors %}
                        {%- set user = sponsor.user -%}
                        {%- if user and user.team -%}
                            <a href="{{ path('team_show', {id: user.team.id}) }}">{{ user.name }}</a>
                        {%- else -%}
                            {{ user ? user.name : '' }}
                        {%- endif -%}
                        {{- not loop.last ? ', ' : '' -}}
                    {% endfor %}
                </p>
                {% endif %}

                <p class="mb-3">
                    <span class="ballot">Status:
                        <span class="status">
                            {%- if issue.status.value == 'Open' -%}
                                {{ onBallot[issue.id] is defined ? 'On Ballot' : 'In Discussion' }}
                            {%- else -%}
                                {{ issue.status.label }}
                            {%- endif -%}
                        </span>
                    </span>
                </p>

                {% if issue.rationale %}
                    <div class="proposal-rationale">{{ issue.rationale|markdown_to_html|raw }}</div>
                {% endif %}

                {% if issue.ruleChangeText %}
                    <blockquote class="mb-0 mt-2 px-3 font-italic">
                        {{ issue.ruleChangeText|markdown_to_html|raw }}
                    </blockquote>
                {% endif %}
            </div>
        </div>
        {% endfor %}
    {% endif %}
</div>
{% endblock %}
